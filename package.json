{
  "name": "gym-ledger",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/select-seed.js && expo start",
    "android": "expo run:android",
    "web": "node scripts/select-seed.js && expo start --web",
    "seed": "node scripts/select-seed.js",
    "test": "node scripts/select-seed.js && tsx --test lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/select-seed.js",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter-tight": "^0.4.0",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "expo": "54.0.34",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-is-edge-to-edge": "^1.2.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "react-native-svg"
      ]
    }
  },
  "private": true
}
